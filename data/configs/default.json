{
  "fields": [
    { "path": "candidate_id",  "from": "candidate_id",       "type": "string", "required": true  },
    { "path": "full_name",     "from": "name",               "type": "string"                    },
    { "path": "email",         "from": "emails[0]",          "type": "string"                    },
    { "path": "phone",         "from": "phones[0]",          "type": "string", "normalize": "e164" },
    { "path": "company",       "from": "current_company",    "type": "string"                    },
    { "path": "title",         "from": "title",              "type": "string"                    },
    { "path": "location",      "from": "location",           "type": "string"                    },
    { "path": "bio",           "from": "bio",                "type": "string"                    },
    { "path": "github_url",    "from": "github_url",         "type": "string"                    },
    { "path": "skills",        "from": "skills[].name",      "type": "array"                     },
    { "path": "merge_state",   "from": "merge_state",        "type": "string"                    },
    { "path": "confidence",    "from": "overall_confidence", "type": "number"                    }
  ],
  "globals": {
    "include_confidence": true,
    "include_provenance": true,
    "on_missing": "null"
  }
}
